#!/bin/sh
set -eu

PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
SYMPHONY_COMMIT=8001b52e3062495a16e520e4ceaf8f9de868c4d0
SYMPHONY_HOME="$PROJECT_ROOT/.symphony"
SOURCE_DIR="$SYMPHONY_HOME/source"
ELIXIR_DIR="$SOURCE_DIR/elixir"
SYMPHONY_BIN="$ELIXIR_DIR/bin/symphony"
CASTORE_PATCH="$PROJECT_ROOT/symphony/patches/add-castore.patch"
RUNTIME_DIR="$SYMPHONY_HOME/runtime"
TEMPLATE="$PROJECT_ROOT/symphony/WORKFLOW.md.template"
RUNTIME_WORKFLOW="$RUNTIME_DIR/WORKFLOW.md"
RUNTIME_WORKFLOW_SHA="$RUNTIME_DIR/WORKFLOW.sha256"
ENV_FILE="$PROJECT_ROOT/.env"

load_env_file() {
  [ -f "$ENV_FILE" ] || return 0

  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|'#'*) continue ;;
      LINEAR_API_KEY=*|LINEAR_PROJECT_SLUG=*|LINEAR_ASSIGNEE=*|SYMPHONY_WORKSPACE_ROOT=*|SOURCE_REPO_URL=*)
        key=${line%%=*}
        value=${line#*=}
        eval "is_set=\${$key+x}"
        if [ "$is_set" != x ]; then
          export "$key=$value"
        fi
        ;;
      *) continue ;;
    esac
  done < "$ENV_FILE"
}

require_build_tools() {
  command -v git >/dev/null 2>&1 || {
    echo "git was not found in PATH." >&2
    exit 1
  }
  command -v mise >/dev/null 2>&1 || {
    echo "mise was not found. Install it with: brew install mise" >&2
    exit 1
  }
}

install_symphony() {
  require_build_tools
  mkdir -p "$SYMPHONY_HOME"

  if [ ! -d "$SOURCE_DIR/.git" ]; then
    git clone https://github.com/openai/symphony.git "$SOURCE_DIR"
  fi

  if [ -n "$(git -C "$SOURCE_DIR" ls-files --others --exclude-standard)" ]; then
    echo "Symphony source has unexpected local changes: $SOURCE_DIR" >&2
    echo "Refusing to overwrite the managed source checkout." >&2
    exit 1
  fi

  current_commit=$(git -C "$SOURCE_DIR" rev-parse HEAD)
  if [ "$current_commit" != "$SYMPHONY_COMMIT" ]; then
    if ! git -C "$SOURCE_DIR" diff --quiet ||
       ! git -C "$SOURCE_DIR" diff --cached --quiet; then
      echo "Symphony source has changes at an unexpected commit; refusing to switch it." >&2
      exit 1
    fi
    git -C "$SOURCE_DIR" fetch --depth 1 origin "$SYMPHONY_COMMIT"
    git -C "$SOURCE_DIR" checkout --detach "$SYMPHONY_COMMIT"
  fi

  if ! git -C "$SOURCE_DIR" diff --cached --quiet; then
    echo "Symphony source has staged changes; refusing to build it." >&2
    exit 1
  fi

  if git -C "$SOURCE_DIR" diff --quiet; then
    git -C "$SOURCE_DIR" apply --unidiff-zero "$CASTORE_PATCH"
  else
    expected_index=$(mktemp "${TMPDIR:-/tmp}/symphony-expected-index.XXXXXX")
    actual_index=$(mktemp "${TMPDIR:-/tmp}/symphony-actual-index.XXXXXX")
    rm -f "$expected_index" "$actual_index"
    trap 'rm -f "$expected_index" "$actual_index"' EXIT HUP INT TERM

    GIT_INDEX_FILE="$expected_index" git -C "$SOURCE_DIR" read-tree "$SYMPHONY_COMMIT"
    GIT_INDEX_FILE="$expected_index" git -C "$SOURCE_DIR" apply --cached --unidiff-zero "$CASTORE_PATCH"
    expected_tree=$(GIT_INDEX_FILE="$expected_index" git -C "$SOURCE_DIR" write-tree)

    GIT_INDEX_FILE="$actual_index" git -C "$SOURCE_DIR" read-tree "$SYMPHONY_COMMIT"
    GIT_INDEX_FILE="$actual_index" git -C "$SOURCE_DIR" add -u
    actual_tree=$(GIT_INDEX_FILE="$actual_index" git -C "$SOURCE_DIR" write-tree)

    if [ "$actual_tree" != "$expected_tree" ]; then
      echo "Symphony source changes do not exactly match the managed CAStore patch." >&2
      exit 1
    fi

    rm -f "$expected_index" "$actual_index"
    trap - EXIT HUP INT TERM
  fi

  (
    cd "$ELIXIR_DIR"
    mise trust
    mise install
    mise exec -- mix setup
    mise exec -- mix build
  )

  [ -x "$SYMPHONY_BIN" ] || {
    echo "Symphony build did not produce $SYMPHONY_BIN" >&2
    exit 1
  }

  echo "Installed Symphony commit $SYMPHONY_COMMIT with the managed CAStore patch"
}

validate_environment() {
  missing=""
  for name in LINEAR_API_KEY LINEAR_PROJECT_SLUG; do
    eval "value=\${$name:-}"
    if [ -z "$value" ]; then
      missing="$missing $name"
    fi
  done

  if [ -n "$missing" ]; then
    echo "Missing required environment variables:$missing" >&2
    echo "Copy .env.example to .env and fill in the Linear values." >&2
    exit 1
  fi

  case "$LINEAR_PROJECT_SLUG" in
    *[!A-Za-z0-9_-]*|'')
      echo "LINEAR_PROJECT_SLUG contains unsupported characters." >&2
      exit 1
      ;;
  esac

  case "$LINEAR_API_KEY" in
    lin_api_replace_me)
      echo "LINEAR_API_KEY is still the example value." >&2
      exit 1
      ;;
  esac

  case "$LINEAR_PROJECT_SLUG" in
    replace-with-project-slug)
      echo "LINEAR_PROJECT_SLUG is still the example value." >&2
      exit 1
      ;;
  esac

  command -v codex >/dev/null 2>&1 || {
    echo "codex was not found in PATH." >&2
    exit 1
  }
  command -v git >/dev/null 2>&1 || {
    echo "git was not found in PATH." >&2
    exit 1
  }
}

workflow_has_tracker_entry() {
  section=$1
  entry=$2
  file=$3
  awk -v section="$section" -v entry="$entry" '
    NR == 1 && $0 == "---" { frontmatter = 1; next }
    frontmatter && $0 == "---" { exit found ? 0 : 1 }
    frontmatter && $0 == "tracker:" { tracker = 1; next }
    tracker && $0 ~ /^[^ ]/ { tracker = 0; list = 0 }
    tracker && $0 == "  " section ":" { list = 1; next }
    list && $0 ~ /^  [^ ]/ { list = 0 }
    list && $0 == "    - " entry { found = 1 }
    END { exit found ? 0 : 1 }
  ' "$file"
}

render_workflow() {
  mode=${1:-apply}
  validate_environment
  mkdir -p "$RUNTIME_DIR"

  escaped_slug=$(printf '%s' "$LINEAR_PROJECT_SLUG" | sed 's/[&|]/\\&/g')
  escaped_controller_root=$(printf '%s' "$PROJECT_ROOT" | sed 's/[&|]/\\&/g')
  temporary_workflow=$(mktemp "$RUNTIME_DIR/.WORKFLOW.md.XXXXXX")
  temporary_sha=$(mktemp "$RUNTIME_DIR/.WORKFLOW.sha256.XXXXXX")
  trap 'rm -f "$temporary_workflow" "$temporary_sha"' EXIT HUP INT TERM
  sed \
    -e "s|__LINEAR_PROJECT_SLUG__|$escaped_slug|g" \
    -e "s|__SYMPHONY_CONTROLLER_ROOT__|$escaped_controller_root|g" \
    "$TEMPLATE" > "$temporary_workflow"

  if grep -Eq '__LINEAR_PROJECT_SLUG__|__SYMPHONY_CONTROLLER_ROOT__' "$temporary_workflow"; then
    echo "Failed to render required workflow values." >&2
    exit 1
  fi

  for required in 'Auto Review' 'Rework'; do
    if ! workflow_has_tracker_entry active_states "$required" "$temporary_workflow"; then
      echo "Rendered workflow is missing tracker.active_states entry: $required" >&2
      exit 1
    fi
  done
  for required in 'Merge Ready' 'Blocked'; do
    if ! workflow_has_tracker_entry terminal_states "$required" "$temporary_workflow"; then
      echo "Rendered workflow is missing tracker.terminal_states entry: $required" >&2
      exit 1
    fi
  done
  if ! grep -Fq 'symphony-workpad:v1' "$temporary_workflow"; then
    echo "Rendered workflow is missing required protocol marker: symphony-workpad:v1" >&2
    exit 1
  fi

  shasum -a 256 "$temporary_workflow" | awk '{print $1}' > "$temporary_sha"
  if [ "$mode" = check ]; then
    rendered_sha=$(sed -n '1p' "$temporary_sha")
    rm -f "$temporary_workflow" "$temporary_sha"
    trap - EXIT HUP INT TERM
    echo "Validated workflow template (sha256=$rendered_sha; runtime unchanged)"
    return 0
  fi
  if [ "$mode" != apply ]; then
    echo "Unknown render mode: $mode" >&2
    exit 1
  fi
  mv "$temporary_workflow" "$RUNTIME_WORKFLOW"
  mv "$temporary_sha" "$RUNTIME_WORKFLOW_SHA"
  trap - EXIT HUP INT TERM

  echo "Rendered $RUNTIME_WORKFLOW (sha256=$(sed -n '1p' "$RUNTIME_WORKFLOW_SHA"))"
}

check_setup() {
  require_build_tools
  [ -x "$SYMPHONY_BIN" ] || {
    echo "Symphony is not built. Run: zsh scripts/symphony install" >&2
    exit 1
  }
  built_commit=$(git -C "$SOURCE_DIR" rev-parse HEAD)
  if [ "$built_commit" != "$SYMPHONY_COMMIT" ]; then
    echo "Symphony source is at $built_commit, expected $SYMPHONY_COMMIT." >&2
    echo "Run: zsh scripts/symphony install" >&2
    exit 1
  fi
  render_workflow check

  echo ""
  echo "Setup checks passed."
  echo "Symphony commit: $built_commit"
  echo "Workflow: $RUNTIME_WORKFLOW"
  echo "Workspace: $SYMPHONY_WORKSPACE_ROOT"
  echo "Repository: $SOURCE_REPO_URL"
}

load_env_file
SYMPHONY_WORKSPACE_ROOT=${SYMPHONY_WORKSPACE_ROOT:-"$SYMPHONY_HOME/workspaces"}
SOURCE_REPO_URL=${SOURCE_REPO_URL:-https://github.com/my-name-is-yu/TrueForgeHackathon.git}
LINEAR_ASSIGNEE=${LINEAR_ASSIGNEE:-me}
export SYMPHONY_WORKSPACE_ROOT SOURCE_REPO_URL LINEAR_ASSIGNEE

command=${1:-start}
case "$command" in
  install)
    install_symphony
    ;;
  render)
    render_workflow
    ;;
  check)
    check_setup
    ;;
  status)
    shift
    exec python3 "$PROJECT_ROOT/scripts/symphony_status.py" "$@"
    ;;
  start)
    check_setup
    render_workflow
    cd "$ELIXIR_DIR"
    exec mise exec -- "$SYMPHONY_BIN" \
      --i-understand-that-this-will-be-running-without-the-usual-guardrails \
      --logs-root "$SYMPHONY_HOME/logs" \
      "$RUNTIME_WORKFLOW"
    ;;
  *)
    echo "Usage: $0 {install|render|check|status|start}" >&2
    exit 1
    ;;
esac
