#!/bin/sh
set -eu

PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PROMPT="$PROJECT_ROOT/symphony/SOL_REVIEW_PROMPT.md"
SCHEMA="$PROJECT_ROOT/symphony/review-decision.schema.json"

if [ "$#" -ne 2 ]; then
  echo "Usage: $0 REVIEW_PACKET.md DECISION.json" >&2
  exit 2
fi

packet=$1
output=$2
[ -f "$packet" ] || { echo "Review packet not found: $packet" >&2; exit 1; }
[ -f "$PROMPT" ] || { echo "Sol prompt not found: $PROMPT" >&2; exit 1; }
[ -f "$SCHEMA" ] || { echo "Decision schema not found: $SCHEMA" >&2; exit 1; }
if grep -Eq 'lin_api_[A-Za-z0-9_-]{8,}|gh[opusr]_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{20,}' "$packet"; then
  echo "Review packet appears to contain a secret; refusing to send it to Sol." >&2
  exit 1
fi
packet_lines=$(wc -l < "$packet" | tr -d ' ')
packet_bytes=$(wc -c < "$packet" | tr -d ' ')
if [ "$packet_lines" -gt 4000 ] || [ "$packet_bytes" -gt 1048576 ]; then
  echo "Review packet exceeds the 4000-line or 1 MiB safety limit; refusing to truncate evidence." >&2
  exit 1
fi

head_sha=$(sed -n 's/^Head SHA: \([0-9a-f]\{40\}\)$/\1/p' "$packet")
[ -n "$head_sha" ] || { echo "Packet must contain exactly one 'Head SHA: <40-char lowercase SHA>' line." >&2; exit 1; }
[ "$(printf '%s\n' "$head_sha" | wc -l | tr -d ' ')" -eq 1 ] || {
  echo "Packet contains multiple head SHA lines." >&2
  exit 1
}
review_head=$(sed -n 's/^Review head number: \([1-3]\)$/\1/p' "$packet")
[ -n "$review_head" ] || { echo "Packet must contain one 'Review head number: <1-3>' line." >&2; exit 1; }
[ "$(printf '%s\n' "$review_head" | wc -l | tr -d ' ')" -eq 1 ] || {
  echo "Packet contains multiple review head number lines." >&2
  exit 1
}
rework_round=$(sed -n 's/^Rework round: \([0-2]\)$/\1/p' "$packet")
[ -n "$rework_round" ] || { echo "Packet must contain one 'Rework round: <0-2>' line." >&2; exit 1; }
[ "$(printf '%s\n' "$rework_round" | wc -l | tr -d ' ')" -eq 1 ] || {
  echo "Packet contains multiple rework round lines." >&2
  exit 1
}

output_dir=$(dirname -- "$output")
[ -d "$output_dir" ] || { echo "Output directory does not exist: $output_dir" >&2; exit 1; }
temporary=$(mktemp "$output_dir/.symphony-sol-decision.XXXXXX")
trap 'rm -f "$temporary"' EXIT HUP INT TERM

{
  sed "s/__EXPECTED_HEAD_SHA__/$head_sha/g" "$PROMPT"
  printf '\n\n# Review packet\n\n'
  sed -n '1,4000p' "$packet"
} | env -u LINEAR_API_KEY -u GH_TOKEN -u GITHUB_TOKEN codex exec \
  --model gpt-5.6-sol \
  --config 'model_reasoning_effort="xhigh"' \
  --config 'approval_policy="never"' \
  --sandbox read-only \
  --ephemeral \
  --ignore-user-config \
  --ignore-rules \
  --output-schema "$SCHEMA" \
  --output-last-message "$temporary" \
  -

python3 "$PROJECT_ROOT/scripts/symphony_review_decision.py" \
  --expected-head "$head_sha" \
  --expected-review-head "$review_head" \
  --expected-rework-round "$rework_round" \
  "$temporary" >/dev/null
mv "$temporary" "$output"
trap - EXIT HUP INT TERM
echo "Validated Sol decision: $output"
