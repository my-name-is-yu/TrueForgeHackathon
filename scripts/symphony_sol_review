#!/bin/sh
set -eu

PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PROMPT="$PROJECT_ROOT/symphony/SOL_REVIEW_PROMPT.md"
SCHEMA="$PROJECT_ROOT/symphony/review-decision.schema.json"

if [ "$#" -ne 2 ]; then
  echo "Usage: $0 REVIEW_PACKET.md DECISION.json" >&2
  exit 2
fi

packet=$1
output=$2
[ -f "$packet" ] || { echo "Review packet not found: $packet" >&2; exit 1; }
[ -f "$PROMPT" ] || { echo "Sol prompt not found: $PROMPT" >&2; exit 1; }
[ -f "$SCHEMA" ] || { echo "Decision schema not found: $SCHEMA" >&2; exit 1; }
if grep -Eq 'lin_api_[A-Za-z0-9_-]{8,}|gh[opusr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{20,}' "$packet"; then
  echo "Review packet appears to contain a secret; refusing to send it to Sol." >&2
  exit 1
fi
packet_lines=$(awk 'END { print NR }' "$packet")
packet_bytes=$(wc -c < "$packet" | tr -d ' ')
if [ "$packet_lines" -gt 4000 ] || [ "$packet_bytes" -gt 1048576 ]; then
  echo "Review packet exceeds the 4000-line or 1 MiB safety limit; refusing to truncate evidence." >&2
  exit 1
fi

[ "$(sed -n '1p' "$packet")" = 'SYMPHONY_REVIEW_PACKET_V2' ] || {
  echo "Packet line 1 must be the trusted-header version marker." >&2
  exit 1
}
head_sha=$(sed -n '2s/^Head SHA: \([0-9a-f]\{40\}\)$/\1/p' "$packet")
[ -n "$head_sha" ] || { echo "Packet line 2 must contain the head SHA." >&2; exit 1; }
review_head=$(sed -En '3s/^Review head number: ([1-9][0-9]*)$/\1/p' "$packet")
[ -n "$review_head" ] || { echo "Packet line 3 must contain the review head number." >&2; exit 1; }
rework_round=$(sed -En '4s/^Rework round: (0|[1-9][0-9]*)$/\1/p' "$packet")
[ -n "$rework_round" ] || { echo "Packet line 4 must contain the rework round." >&2; exit 1; }
current_reviewer=$(sed -En '5s/^Current reviewer: (codex|qodo|both)$/\1/p' "$packet")
[ -n "$current_reviewer" ] || { echo "Packet line 5 must contain the current reviewer." >&2; exit 1; }
[ "$(sed -n '6p' "$packet")" = '--- END TRUSTED HEADER ---' ] || {
  echo "Packet line 6 must terminate the trusted header." >&2
  exit 1
}

output_dir=$(dirname -- "$output")
[ -d "$output_dir" ] || { echo "Output directory does not exist: $output_dir" >&2; exit 1; }
temporary=$(mktemp "$output_dir/.symphony-sol-decision.XXXXXX")
temporary_workspace=$(mktemp -d "$output_dir/.symphony-sol-workspace.XXXXXX")
trap 'rm -f "$temporary"; rm -rf "$temporary_workspace"' EXIT HUP INT TERM

{
  sed "s/__EXPECTED_HEAD_SHA__/$head_sha/g" "$PROMPT"
  printf '\n\n# Review packet\n\n'
  cat "$packet"
} | env -u LINEAR_API_KEY -u GH_TOKEN -u GITHUB_TOKEN codex exec \
  --model gpt-5.6-sol \
  --config 'model_reasoning_effort="xhigh"' \
  --config 'approval_policy="never"' \
  --sandbox read-only \
  --ephemeral \
  --ignore-user-config \
  --ignore-rules \
  --disable shell_tool \
  --disable unified_exec \
  --disable multi_agent \
  --disable view_image \
  --disable apps \
  --disable browser_use \
  --disable computer_use \
  --disable image_generation \
  --disable plugins \
  --disable memories \
  --config 'mcp_servers={}' \
  --config 'web_search="disabled"' \
  --config 'shell_environment_policy.inherit="none"' \
  --cd "$temporary_workspace" \
  --skip-git-repo-check \
  --output-schema "$SCHEMA" \
  --output-last-message "$temporary" \
  -

mv "$temporary" "$output"
rm -rf "$temporary_workspace"
trap - EXIT HUP INT TERM
echo "Wrote schema-valid Sol decision: $output"
