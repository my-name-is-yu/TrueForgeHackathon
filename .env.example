# Create this token in Linear: Settings > Security & access > Personal API keys.
LINEAR_API_KEY=lin_api_replace_me

# Copy the slug from the end of the Linear project URL.
LINEAR_PROJECT_SLUG=replace-with-project-slug

# Optional overrides
# LINEAR_ASSIGNEE=me
# SYMPHONY_WORKSPACE_ROOT=/absolute/path/to/symphony-workspaces
# SOURCE_REPO_URL=https://github.com/my-name-is-yu/TrueForgeHackathon.git

